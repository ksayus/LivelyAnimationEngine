<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <RootNamespace>LAE</RootNamespace>
    <AssemblyName>LivelyAnimationEngine</AssemblyName>
    <Version>1.1.0</Version>
    <Product>LAE — Lively Animation Engine</Product>
    <Description>轻量高性能的 WPF 流式动画引擎</Description>

    <!--
      类库默认只输出 DLL。Debug 配置下额外编译 DebugHost/ 里的极小宿主入口并把输出类型
      切成 WinExe，这样在 VS / dotnet run 里可以直接 F5 调试，不会再提示
      “无法直接启动带有‘类库输出类型’的项目”。Release 保持纯类库输出。

      需要还原纯 DLL 的 Debug 产物：
        dotnet build LAE/LivelyAnimationEngine.csproj -c Debug -p:DebugAsExecutable=false
    -->
    <DebugAsExecutable Condition="'$(DebugAsExecutable)' == '' And '$(Configuration)' == 'Debug'">true</DebugAsExecutable>
    <DebugAsExecutable Condition="'$(DebugAsExecutable)' == ''">false</DebugAsExecutable>
    <OutputType Condition="'$(DebugAsExecutable)' == 'true'">WinExe</OutputType>
    <StartupObject Condition="'$(DebugAsExecutable)' == 'true'">LAE.DebugHost.DebugProgram</StartupObject>
  </PropertyGroup>

  <!-- 宿主代码只有在可执行调试模式下才参与编译，绝不进入类库产物 -->
  <ItemGroup>
    <Compile Remove="DebugHost/**/*.cs" />
    <None Include="DebugHost/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(DebugAsExecutable)' == 'true'">
    <Compile Include="DebugHost/**/*.cs" />
    <None Remove="DebugHost/**/*.cs" />
  </ItemGroup>

</Project>
