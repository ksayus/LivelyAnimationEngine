<Window x:Class="UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LAE 引擎全功能测试" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0" Background="#F0F0F0" Padding="8" BorderBrush="#CCC" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <TextBlock Text="速度:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Slider x:Name="sliderSpeed" Width="120" Minimum="0.1" Maximum="5" Value="1"
                            ValueChanged="SliderSpeed_Changed"/>
                    <TextBlock x:Name="txtSpeed" Text="1.0x" VerticalAlignment="Center" Margin="6,0,0,0" Width="40"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Grid.Column="1" Margin="12,0,0,0">
                    <Button x:Name="btnFreeze" Content="冻结" Click="BtnFreeze_Click" Width="60" Margin="0,0,4,0"/>
                    <Button x:Name="btnUnfreeze" Content="解冻" Click="BtnUnfreeze_Click" Width="60" Margin="0,0,4,0"/>
                    <Button x:Name="btnStopAll" Content="停止全部" Click="BtnStopAll_Click" Width="70" Background="#E74C3C" Foreground="White"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Grid.Column="3">
                    <Button x:Name="btnResetAll" Content="重置全部" Click="BtnResetAll_Click" Width="80" Margin="0,0,4,0"/>
                    <TextBlock x:Name="txtStatus" Text="就绪" VerticalAlignment="Center" Foreground="Gray" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体区域 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧测试面板 -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Background="#FAFAFA">
                <StackPanel Margin="8">
                    <TextBlock Text="── 变换动画 ──" FontWeight="Bold" Margin="0,4,0,4"/>
                    <Button Content="Move (相对移动)" Click="BtnMoveBy_Click" Margin="0,2"/>
                    <Button Content="MoveTo (绝对移动)" Click="BtnMoveTo_Click" Margin="0,2"/>
                    <Button Content="Scale (绝对缩放)" Click="BtnScale_Click" Margin="0,2"/>
                    <Button Content="ScaleBy (相对缩放)" Click="BtnScaleBy_Click" Margin="0,2"/>
                    <Button Content="Rotate (绝对旋转)" Click="BtnRotate_Click" Margin="0,2"/>
                    <Button Content="RotateBy (相对旋转)" Click="BtnRotateBy_Click" Margin="0,2"/>
                    <Button Content="Skew (绝对偏斜)" Click="BtnSkew_Click" Margin="0,2"/>
                    <Button Content="SkewBy (相对偏斜)" Click="BtnSkewBy_Click" Margin="0,2"/>

                    <TextBlock Text="── 属性动画 ──" FontWeight="Bold" Margin="0,10,0,4"/>
                    <Button Content="Color (画刷颜色)" Click="BtnColor_Click" Margin="0,2"/>
                    <Button Content="Color (元素属性)" Click="BtnColorElement_Click" Margin="0,2"/>
                    <Button Content="Opacity (绝对)" Click="BtnOpacity_Click" Margin="0,2"/>
                    <Button Content="OpacityBy (相对)" Click="BtnOpacityBy_Click" Margin="0,2"/>
                    <Button Content="Width (绝对)" Click="BtnWidth_Click" Margin="0,2"/>
                    <Button Content="WidthBy (相对)" Click="BtnWidthBy_Click" Margin="0,2"/>
                    <Button Content="Height (绝对)" Click="BtnHeight_Click" Margin="0,2"/>
                    <Button Content="HeightBy (相对)" Click="BtnHeightBy_Click" Margin="0,2"/>

                    <TextBlock Text="── 快捷方法 ──" FontWeight="Bold" Margin="0,10,0,4"/>
                    <Button Content="FadeIn (淡入)" Click="BtnFadeIn_Click" Margin="0,2"/>
                    <Button Content="FadeOut (淡出)" Click="BtnFadeOut_Click" Margin="0,2"/>

                    <TextBlock Text="── 组合控制 ──" FontWeight="Bold" Margin="0,10,0,4"/>
                    <Button Content="Sequence (序列)" Click="BtnSeq_Click" Margin="0,2"/>
                    <Button Content="Parallel (并行)" Click="BtnPar_Click" Margin="0,2"/>
                    <Button Content="Delay (延迟)" Click="BtnDelay_Click" Margin="0,2"/>
                    <Button Content="Wait (等待)" Click="BtnWait_Click" Margin="0,2"/>
                    <Button Content="Callback (回调)" Click="BtnCallback_Click" Margin="0,2"/>
                    <Button Content="OnComplete (完成回调)" Click="BtnOnComplete_Click" Margin="0,2"/>

                    <TextBlock Text="── 引擎控制 ──" FontWeight="Bold" Margin="0,10,0,4"/>
                    <Button Content="Stop (命名停止)" Click="BtnStopNamed_Click" Margin="0,2"/>
                    <Button Content="IsRunning (查询)" Click="BtnIsRunning_Click" Margin="0,2"/>
                    <Button Content="ActiveGroupCount" Click="BtnActiveCount_Click" Margin="0,2"/>
                    <Button Content="IsFrozen (状态)" Click="BtnIsFrozen_Click" Margin="0,2"/>

                    <TextBlock Text="── 缓动函数 ──" FontWeight="Bold" Margin="0,10,0,4"/>
                    <Button Content="Linear (线性)" Click="BtnEasingLinear_Click" Margin="0,2"/>
                    <Button Content="OutCubic (缓出)" Click="BtnEasingOutCubic_Click" Margin="0,2"/>
                    <Button Content="InOutCubic (缓入缓出)" Click="BtnEasingInOutCubic_Click" Margin="0,2"/>
                    <Button Content="OutPow(5) (强缓出)" Click="BtnEasingOutPow5_Click" Margin="0,2"/>
                    <Button Content="InOutPow(5) (强缓入缓出)" Click="BtnEasingInOutPow5_Click" Margin="0,2"/>
                </StackPanel>
            </ScrollViewer>

            <!-- 右侧画布 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Canvas Grid.Row="0" x:Name="stage" Background="#2C3E50" ClipToBounds="True">
                    <!-- 主测试矩形 (带变换组) -->
                    <Rectangle x:Name="rectMain" Width="80" Height="80" Fill="#3498DB"
                               Canvas.Left="200" Canvas.Top="120"
                               RenderTransformOrigin="0.5,0.5">
                        <Rectangle.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="scaleTransform" ScaleX="1" ScaleY="1"/>
                                <SkewTransform x:Name="skewTransform" AngleX="0" AngleY="0"/>
                                <RotateTransform x:Name="rotateTransform" Angle="0"/>
                                <TranslateTransform x:Name="translateTransform" X="0" Y="0"/>
                            </TransformGroup>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <TextBlock Canvas.Left="200" Canvas.Top="100" Text="主矩形" Foreground="White" FontSize="11"/>

                    <!-- 颜色测试矩形 -->
                    <Rectangle x:Name="rectColor" Width="60" Height="60" Fill="#E74C3C"
                               Canvas.Left="400" Canvas.Top="130"/>
                    <TextBlock Canvas.Left="400" Canvas.Top="110" Text="颜色测试" Foreground="White" FontSize="11"/>

                    <!-- 不透明度测试圆 -->
                    <Ellipse x:Name="ellipseOpacity" Width="70" Height="70" Fill="#2ECC71"
                             Canvas.Left="380" Canvas.Top="260" Opacity="1.0"/>
                    <TextBlock Canvas.Left="380" Canvas.Top="240" Text="不透明度测试" Foreground="White" FontSize="11"/>

                    <!-- 宽高测试边框 -->
                    <Border x:Name="borderSize" Width="80" Height="80" Background="#9B59B6"
                            Canvas.Left="50" Canvas.Top="260"/>
                    <TextBlock Canvas.Left="50" Canvas.Top="240" Text="宽高测试" Foreground="White" FontSize="11"/>

                    <!-- 淡入淡出测试矩形 -->
                    <Rectangle x:Name="rectFade" Width="60" Height="60" Fill="#F39C12"
                               Canvas.Left="50" Canvas.Top="130" Opacity="1.0"/>
                    <TextBlock Canvas.Left="50" Canvas.Top="110" Text="淡入淡出" Foreground="White" FontSize="11"/>

                    <!-- 日志区域 -->
                    <Border Canvas.Left="500" Canvas.Top="90" Width="400" Height="350"
                            Background="#1A1A2E" BorderBrush="#555" BorderThickness="1">
                        <ScrollViewer x:Name="logScroll" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="txtLog" Foreground="#0F0" FontFamily="Consolas" FontSize="11"
                                       TextWrapping="Wrap" Margin="6"/>
                        </ScrollViewer>
                    </Border>
                    <TextBlock Canvas.Left="500" Canvas.Top="70" Text="运行日志" Foreground="White" FontSize="11"/>
                </Canvas>

                <!-- 底部信息栏 -->
                <Border Grid.Row="1" Background="#F0F0F0" Padding="6" BorderBrush="#CCC" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="txtActiveGroups" Text="活跃组: 0" Margin="0,0,20,0"/>
                        <TextBlock x:Name="txtFrozen" Text="冻结: 否" Margin="0,0,20,0"/>
                        <TextBlock x:Name="txtSpeedInfo" Text="速度: 1.0x"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>