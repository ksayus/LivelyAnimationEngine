<Window x:Class="UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LAE — Lively Animation Engine  演示台"
        Height="780" Width="1280" MinHeight="620" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgWindow}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Border Grid.Row="0" Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1">
            <Grid Margin="18,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 品牌 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="8" Margin="0,0,10,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{StaticResource AccentColor}" Offset="0"/>
                                <GradientStop Color="{StaticResource AccentAltColor}" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="LA" FontWeight="Bold" FontSize="13" Foreground="#FF06121B"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Lively Animation Engine" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock x:Name="txtSubtitle" Text="交互式动画演示台" FontSize="11"
                                   Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                </StackPanel>

                <!-- 速度 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <TextBlock Text="速度" VerticalAlignment="Center" FontSize="12"
                               Foreground="{StaticResource TextSecondary}" Margin="0,0,8,0"/>
                    <Slider x:Name="sliderSpeed" Style="{StaticResource FlatSlider}" Width="180"
                            Minimum="0.1" Maximum="5" Value="1"
                            ValueChanged="SliderSpeed_Changed" VerticalAlignment="Center"/>
                    <Border Background="{StaticResource BgInset}" CornerRadius="4" Padding="7,2" Margin="10,0,0,0">
                        <TextBlock x:Name="txtSpeed" Text="1.0x" FontFamily="{StaticResource MonoFont}"
                                   FontSize="12" Foreground="{StaticResource Accent}" Width="42"
                                   TextAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- 操作 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnReplay" Content="重播" Style="{StaticResource ToolButton}"
                            Click="BtnReplay_Click" Margin="0,0,8,0"/>
                    <Button x:Name="btnStopAll" Content="停止全部" Style="{StaticResource ToolButton}"
                            Click="BtnStopAll_Click" Margin="0,0,8,0"/>
                    <Button x:Name="btnReset" Content="重置舞台" Style="{StaticResource ToolButton}"
                            Click="BtnReset_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="272"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="384"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧演示列表 -->
            <Border Grid.Column="0" Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="演示目录 ·  点击即播放" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMuted}" Margin="18,14,18,8"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,0,12,0">
                        <StackPanel x:Name="demoList"/>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="{StaticResource BgInset}" Padding="14,10"
                            BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <TextBlock x:Name="txtSelectedName" Text="未选择" FontSize="12"
                                       FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock x:Name="txtSelectedDesc" Text="从上方选择一个演示"
                                       FontSize="11" Foreground="{StaticResource TextMuted}"
                                       TextWrapping="Wrap" Margin="0,4,0,10"/>
                            <Button x:Name="btnPlaySelected" Content="播放演示 ▶"
                                    Style="{StaticResource PrimaryButton}" Click="BtnPlaySelected_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 中间舞台 -->
            <Grid Grid.Column="1" Background="{StaticResource BgStage}">
                <Canvas x:Name="stage" ClipToBounds="True">
                    <Canvas.Background>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,32,32" ViewportUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <GeometryDrawing>
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry Rect="0,0,32,32"/>
                                    </GeometryDrawing.Geometry>
                                    <GeometryDrawing.Pen>
                                        <Pen Brush="#FF151C26" Thickness="1"/>
                                    </GeometryDrawing.Pen>
                                </GeometryDrawing>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Canvas.Background>
                </Canvas>

                <!-- 舞台左上角信息 -->
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,14"
                        Background="#B30B0E14" CornerRadius="8" Padding="12,8"
                        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="txtStageTitle" Text="舞台" FontSize="12"
                                   Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="txtStageHint" FontSize="11" Margin="0,3,0,0"
                                   Foreground="{StaticResource TextMuted}"
                                   Text="点击左侧演示即可在舞台看到效果"/>
                    </StackPanel>
                </Border>

                <!-- 性能浮层 -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16,14"
                        Background="#CC0E1219" CornerRadius="8" Padding="12,8"
                        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="FPS" FontSize="10" Foreground="{StaticResource TextMuted}"
                                       Width="52"/>
                            <TextBlock x:Name="txtFps" Text="—" FontFamily="{StaticResource MonoFont}"
                                       FontSize="11" Foreground="{StaticResource Success}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="活跃组" FontSize="10" Foreground="{StaticResource TextMuted}"
                                       Width="52"/>
                            <TextBlock x:Name="txtGroups" Text="0" FontFamily="{StaticResource MonoFont}"
                                       FontSize="11" Foreground="{StaticResource TextPrimary}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="帧驱动" FontSize="10" Foreground="{StaticResource TextMuted}"
                                       Width="52"/>
                            <TextBlock x:Name="txtHooked" Text="idle" FontFamily="{StaticResource MonoFont}"
                                       FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 冻结提示 -->
                <Border x:Name="freezeBadge" HorizontalAlignment="Center" VerticalAlignment="Top"
                        Margin="0,14,0,0" Background="#33FFB020" BorderBrush="#FFFFB020"
                        BorderThickness="1" CornerRadius="6" Padding="12,5" Visibility="Collapsed">
                    <TextBlock Text="引擎已冻结 — 所有动画暂停推进" FontSize="11" Foreground="#FFFFC65C"/>
                </Border>
            </Grid>

            <!-- 右侧代码与日志 -->
            <Border Grid.Column="2" Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource BorderSoft}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="220"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="16,14,16,6">
                        <TextBlock Text="LAE 代码" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMuted}"/>
                        <TextBlock x:Name="txtCodeHint" Text="选择演示后显示对应调用" FontSize="10"
                                   Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right"/>
                    </Grid>

                    <Border Grid.Row="1" Background="{StaticResource BgInset}" CornerRadius="8"
                            Margin="16,0,16,12" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,10">
                            <TextBlock x:Name="txtCode" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                       Foreground="#FFB9C7DA" TextWrapping="NoWrap" LineHeight="18"/>
                        </ScrollViewer>
                    </Border>

                    <Grid Grid.Row="2" Margin="16,4,16,6">
                        <TextBlock Text="运行日志" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMuted}"/>
                        <Button Content="清空" HorizontalAlignment="Right" Padding="8,2" FontSize="10"
                                Style="{StaticResource ToolButton}" Click="BtnClearLog_Click"/>
                    </Grid>

                    <Border Grid.Row="3" Background="{StaticResource BgInset}" CornerRadius="8"
                            Margin="16,0,16,16" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1">
                        <ScrollViewer x:Name="logScroll" VerticalScrollBarVisibility="Auto" Padding="12,10">
                            <TextBlock x:Name="txtLog" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                       Foreground="#FF7FD8A0" TextWrapping="Wrap" LineHeight="17"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2" Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,1,0,0" Padding="18,7">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="statusDot" Width="7" Height="7" Fill="{StaticResource Success}"
                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="txtStatus" Text="就绪" FontSize="11"
                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="txtStats" HorizontalAlignment="Right" FontSize="11"
                           FontFamily="{StaticResource MonoFont}"
                           Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
