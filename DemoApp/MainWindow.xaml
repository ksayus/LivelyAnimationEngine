<Window x:Class="DemoApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LAE Demo" Height="420" Width="700">
  <Grid Margin="10">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="200"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,0,10,0">
      <Button Name="btnMove" Content="Move" Click="BtnMove_Click" Margin="0,4"/>
      <Button Name="btnMoveTo" Content="MoveTo" Click="BtnMoveTo_Click" Margin="0,4"/>
      <Button Name="btnScale" Content="Scale" Click="BtnScale_Click" Margin="0,4"/>
      <Button Name="btnRotate" Content="Rotate" Click="BtnRotate_Click" Margin="0,4"/>
      <Button Name="btnColor" Content="Color" Click="BtnColor_Click" Margin="0,4"/>
      <Button Name="btnSeq" Content="Sequence" Click="BtnSeq_Click" Margin="0,4"/>
      <Button Name="btnPar" Content="Parallel" Click="BtnPar_Click" Margin="0,4"/>
      <Button Name="btnDelay" Content="Delay+Move" Click="BtnDelay_Click" Margin="0,4"/>
      <Button Name="btnWait" Content="Wait(1s)" Click="BtnWait_Click" Margin="0,4"/>
      <Button Name="btnCallback" Content="Callback" Click="BtnCallback_Click" Margin="0,4"/>
      <Button Name="btnReset" Content="Reset" Click="BtnReset_Click" Margin="0,4"/>
      <Button Name="btnFreeze" Content="Freeze" Click="BtnFreeze_Click" Margin="0,4"/>
      <Button Name="btnUnfreeze" Content="Unfreeze" Click="BtnUnfreeze_Click" Margin="0,4"/>
      <TextBlock Text="Speed" Margin="0,8,0,0"/>
      <Slider Name="sliderSpeed" Minimum="0.1" Maximum="5" Value="1" ValueChanged="SliderSpeed_ValueChanged"/>
    </StackPanel>
    <Canvas Grid.Column="1" Name="stage" Background="LightGray">
      <Rectangle Name="rect" Width="100" Height="100" Fill="Blue" Canvas.Left="50" Canvas.Top="50"
                 RenderTransformOrigin="0.5,0.5">
        <Rectangle.RenderTransform>
          <TransformGroup>
            <ScaleTransform x:Name="scaleTransform" ScaleX="1" ScaleY="1"/>
            <RotateTransform x:Name="rotateTransform" Angle="0"/>
            <TranslateTransform x:Name="translateTransform" X="0" Y="0"/>
          </TransformGroup>
        </Rectangle.RenderTransform>
      </Rectangle>
    </Canvas>
  </Grid>
</Window>
